DATABASE_URL=""
AUTH_SECRET=""
# Public app URL used by Auth.js and public share links in production.
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Product extraction (Phase 3) — server-only, never NEXT_PUBLIC.
# Comma-separated list of EXACT hostnames allowed for extraction. Empty disables
# extraction (manual product entry keeps working). Use only real, verified hosts
# — subdomains are NOT implied.
PRODUCT_EXTRACTION_ALLOWED_HOSTS="minhacea.cea.com.br,www.cea.com.br"
PRODUCT_EXTRACTION_TIMEOUT_MS="8000"
PRODUCT_EXTRACTION_MAX_REDIRECTS="5"
PRODUCT_EXTRACTION_MAX_BYTES="8388608"

# Live cover image upload — Vercel Blob in production. Server-only, never
# NEXT_PUBLIC. In local development, an empty token falls back to public/uploads.
# Set this in production from the Vercel Blob store.
BLOB_READ_WRITE_TOKEN=""
